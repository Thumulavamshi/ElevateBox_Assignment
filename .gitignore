# Local backend database — 183 MB, and it holds real call transcripts,
# recording URLs and phone numbers. Never publish this.
backend/data/

# Real call recordings and transcripts. Same reason: these are actual
# conversations with real numbers in them, and 22 raw provider payloads add
# nothing a reader wants. The measured results are quoted in docs/ instead.
agent/transcripts/
experiments/**/recordings/
experiments/**/results/*.json

