# Copy this file to .env and fill in the blanks.
# .env is gitignored and run_probe.py never prints its values.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------- REQUIRED (3)

# 1. Vapi dashboard -> Settings -> API Keys -> the PRIVATE key.
#    (The public key is for web widgets and will fail with 401 here.)
VAPI_API_KEY=

# 2. Vapi dashboard -> Phone Numbers -> Import (Twilio) -> click it -> copy the ID.
#    This is a UUID, NOT the phone number itself.
VAPI_PHONE_NUMBER_ID=

# 3. YOUR OWN Indian mobile, E.164 format, no spaces or dashes.
#    e.g. +919876543210
#    The evaluator's number is hard-blocked by the script.
TEST_NUMBER=

# ---------------------------------------------------------------- OPTIONAL

# Filled in after the first `preflight` — lets later runs reuse the same
# assistant instead of creating a new one each time.
VAPI_ASSISTANT_ID=

# Override the voice without editing assistant.json. Only needed if Vapi
# rejects the default (azure / en-IN-NeerjaNeural). See README.
# VOICE_PROVIDER=azure
# VOICE_ID=en-IN-NeerjaNeural
